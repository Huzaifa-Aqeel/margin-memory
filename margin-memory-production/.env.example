# Supabase: web app and optional AgentCore runtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Trusted server only; never expose in NEXT_PUBLIC_* or browser code
SUPABASE_SECRET_KEY=

# Strands on Bedrock: normal AWS SDK credentials (profile locally, IAM role in AWS)
AWS_REGION=us-east-1
# Leave empty only for explicitly labelled deterministic local development
BEDROCK_MODEL_ID=

# Independent semantic-memory configuration; existing database dimensions stay 1536
EMBEDDING_PROVIDER=bedrock
# Use amazon.titan-embed-text-v1 (1536 dimensions); cohere.embed-v4:0 is also supported
BEDROCK_EMBEDDING_MODEL_ID=

# Optional remote runtime; local works without AgentCore
AGENT_RUNTIME=local
AGENTCORE_RUNTIME_ARN=

# Build-time helper for generating the Excel Office Add-in manifest; must be HTTPS
OFFICE_ADDIN_ORIGIN=
