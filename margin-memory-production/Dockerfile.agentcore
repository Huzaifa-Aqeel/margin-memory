FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
# Runtime is compiled with the actual TypeScript loader; no Next request context is required.
RUN NODE_OPTIONS=--conditions=react-server ./node_modules/.bin/tsx -e "import('./src/runtime/handler.ts').then(() => console.log('Runtime imports verified'))"
USER node
ENV NODE_ENV=production
ENV NODE_OPTIONS=--conditions=react-server
EXPOSE 8080
CMD ["node", "node_modules/tsx/dist/cli.mjs", "src/runtime/server.ts"]
